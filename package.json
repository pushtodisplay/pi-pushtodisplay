{
  "name": "pi-pushtodisplay",
  "version": "0.2.3",
  "description": "Mirror pi agent activity onto your Push To Display board as a shared, human-readable log (lifecycle, tasks, tool steps, alerts, errors)",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "pushtodisplay",
    "push-to-display",
    "display",
    "signage",
    "dashboard",
    "real-time",
    "status-board"
  ],
  "license": "MIT",
  "author": {
    "name": "Goban Source, LLC",
    "email": "hello@pushtodisplay.com",
    "url": "https://pushtodisplay.com"
  },
  "homepage": "https://pushtodisplay.com",
  "bugs": {
    "url": "https://github.com/pushtodisplay/pi-pushtodisplay/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pushtodisplay/pi-pushtodisplay.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "check": "npm run typecheck && npm run lint && npm test",
    "prepublishOnly": "npm run check"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "index.ts",
    "src",
    "!src/__tests__",
    "skills",
    "vendor",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@eslint/js": "^9.39.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.3",
    "eslint": "^9.25.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.59.1"
  }
}
